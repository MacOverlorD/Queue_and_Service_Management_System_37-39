# Copy to server/.env and fill in local development values.
# These are placeholders only. Never commit real secrets.

# PostgreSQL connection used by Prisma
DATABASE_URL=postgresql://queue_dev:queue_dev_password@localhost:5432/queue_dev

# API server
PORT=3000

# Allowed browser origin for the client (CORS and cookies)
CLIENT_ORIGIN=http://localhost:5173

# Session lifetime in hours (decision D-10)
SESSION_TTL_HOURS=8
