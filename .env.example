# Copy to server/.env (and client/.env where noted) and adjust for local development.
# These are development-only placeholders. Never commit real secrets.

# PostgreSQL connection used by Prisma (development database)
DATABASE_URL=postgresql://queue_dev:queue_dev_password@localhost:5432/queue_dev

# PostgreSQL connection used by the automated tests (separate database, reset on every run)
TEST_DATABASE_URL=postgresql://queue_dev:queue_dev_password@localhost:5432/queue_test

# API server
PORT=3000

# Allowed browser origin for the client (CORS and cookies)
CLIENT_ORIGIN=http://localhost:5173

# Session lifetime in hours (decision D-10)
SESSION_TTL_HOURS=8

# Password for seeded accounts (hashed with bcrypt in the database). Development placeholder only.
# With NODE_ENV=production the seed refuses to run unless this is set; on GCP it comes from Secret Manager.
SEED_PASSWORD=DemoPass123!

# Runtime mode: "production" enables the Secure cookie and hides error details.
# The API also serves the built client from ../client/dist (the Docker image has it).
NODE_ENV=development

# Client (Vite) options, optional. VITE_API_PROXY: API origin the dev server proxies /api to.
# VITE_REFRESH_MS: polling interval for the ticket screen in milliseconds (default 10000).
# VITE_API_PROXY=http://localhost:3000
# VITE_REFRESH_MS=10000
